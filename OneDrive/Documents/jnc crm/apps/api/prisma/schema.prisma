// Prisma Schema for JNC-CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Note: SQLite does not support Prisma enums — all status/type fields use plain String below.
// Valid values are enforced at the application layer (NestJS validation pipes + DTOs).

model User {
  id            String    @id @default(uuid())
  employeeCode  String    @unique
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("employee") // super_admin | admin | sub_admin | employee | store_manager | project_manager | developer_lead | developer
  teamId            String?
  teamRef           Team?     @relation("UserTeam", fields: [teamId], references: [id])
  team              String?
  warehouseId       String?
  phone             String?
  isActive          Boolean   @default(true)
  mustResetPassword Boolean   @default(false)
  lastLoginAt       DateTime?
  failedLoginAttempts Int     @default(0)
  lockoutUntil        DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  createdBy         User?           @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers      User[]          @relation("CreatedUsers")
  assignedLeads     Lead[]          @relation("AssignedLeads")
  sharedLeads       LeadShare[]     @relation("SharedLeads")
  leadActivities    LeadActivity[]  @relation("PerformedActivities")
  createdQuotes     Quotation[]     @relation("CreatedQuotes")
  createdOrders     Order[]         @relation("CreatedOrders")
  createdInvoices   Invoice[]       @relation("CreatedInvoices")
  stockMovements    StockMovement[] @relation("UserStockMovements")
  initiatedTransfers StockTransfer[] @relation("InitiatedTransfers")
  receivedTransfers  StockTransfer[] @relation("ReceivedTransfers")
  createdCustomObjects CustomObject[] @relation("CreatedCustomObjects")
  createdCustomRecords CustomObjectRecord[] @relation("CreatedCustomRecords")
  updatedCustomRecords CustomObjectRecord[] @relation("UpdatedCustomRecords")
  auditLogs         AuditLog[]      @relation("UserAuditLogs")
  recordedPayments  PaymentRecord[] @relation("RecordedPayments")
  createdProjects   Project[]       @relation("CreatedProjects")
  uploadedProjectLogs ProjectDailyLog[] @relation("UploadedProjectLogs")
  projectAssignments ProjectAssignment[] @relation("AssignedProjectUser")
  createdProjectAssignments ProjectAssignment[] @relation("AssignedByProjectUser")
}

model Company {
  id          String    @id @default(uuid())
  name        String
  gstin       String?
  industry    String?
  address     String?
  city        String?
  state       String?   @default("Karnataka")
  website     String?
  billingEmail String?  // Default invoice recipient email (Accounts Payable)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  contacts    Contact[]
  leads       Lead[]
  invoices    Invoice[]
}

model Contact {
  id          String    @id @default(uuid())
  companyId   String?
  name        String
  email       String?
  phone       String
  designation String?
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company     Company?    @relation(fields: [companyId], references: [id])
  leads       Lead[]
  quotations  Quotation[]
  orders      Order[]
}

model Lead {
  id              String      @id @default(uuid())
  leadNumber      String      @unique
  source          String      @default("manual") // indiamart | web | whatsapp | manual
  status          String      @default("new")    // new | contacted | qualified | quoted | won | lost
  companyId       String?
  contactId       String?
  assignedToId    String?
  
  customerName    String
  customerPhone   String
  customerEmail   String?
  city            String?
  productCategory String?
  productName     String?
  quantity        Int?
  estimatedValue  Float?      @default(0)
  urgency         String?     @default("standard") // urgent | standard | planning
  queryMessage    String?
  rawPayload      String?     // Raw JSON from webhook
  isDuplicate     Boolean     @default(false)
  lostReason      String?
  
  capturedAt      DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  company         Company?       @relation(fields: [companyId], references: [id])
  contact         Contact?       @relation(fields: [contactId], references: [id])
  assignedTo      User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  activities      LeadActivity[]
  quotations      Quotation[]
  shares          LeadShare[]
}

model LeadShare {
  id          String   @id @default(uuid())
  leadId      String
  userId      String
  sharedById  String?
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User     @relation("SharedLeads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leadId, userId])
}

model MailAccount {
  id           String   @id @default(uuid())
  name         String   // e.g. "Primary Billing Mail"
  email        String
  senderName   String?
  smtpHost     String
  smtpPort     Int      @default(587)
  smtpUser     String
  smtpPass     String
  isSecure     Boolean  @default(false)
  purpose      String   @default("PRIMARY_ALERTS") // PRIMARY_ALERTS | BILLING_INVOICES | SALES_OUTBOUND
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LeadActivity {
  id          String    @id @default(uuid())
  leadId      String
  userId      String?
  type        String    // call | email | note | meeting | reminder | task
  title       String
  description String?
  scheduledAt DateTime?
  completedAt DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy User?     @relation("PerformedActivities", fields: [userId], references: [id])
}

model Supplier {
  id            String    @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  gstin         String?
  address       String?
  city          String?
  leadTimeDays  Int       @default(7)
  rating        Float?    @default(4.5)
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  preferredSkus   Sku[]           @relation("PreferredSupplier")
  stockMovements  StockMovement[] @relation("SupplierMovements")
}

model Product {
  id          String    @id @default(uuid())
  name        String
  category    String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  skus        Sku[]
}

model Sku {
  id                  String    @id @default(uuid())
  productId           String?
  skuCode             String    @unique
  name                String
  category            String
  hsnCode             String?   // Placeholder HSN - confirm with accountant
  packageType         String?   // Unit, Set, Piece, Meter, Drum, etc.
  unitPrice           Float
  costPrice           Float
  taxRate             Float     @default(18.0) // Per-SKU GST Rate (e.g. 18.0, 12.0, 28.0, 5.0)
  reorderPoint        Int       @default(100)
  reorderQty          Int       @default(500)
  datasheetUrl        String?
  preferredSupplierId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  product             Product?        @relation(fields: [productId], references: [id])
  preferredSupplier   Supplier?       @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id])
  stockItems          StockItem[]
  stockMovements      StockMovement[]
  quotationLines      QuotationLine[]
  orderLines          OrderLine[]
  invoiceLines        InvoiceLine[]
  transfers           StockTransfer[]
}

model Warehouse {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  address     String?
  city        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  bins              LocationBin[]
  stockItems        StockItem[]
  sourceMovements   StockMovement[] @relation("SourceWarehouse")
  destMovements     StockMovement[] @relation("DestWarehouse")
  outgoingTransfers StockTransfer[] @relation("SourceTransfers")
  incomingTransfers StockTransfer[] @relation("DestTransfers")
}

model LocationBin {
  id          String    @id @default(uuid())
  warehouseId String
  binCode     String    // e.g. BLR-A-03-B12
  zone        String
  rack        String
  shelf       String
  createdAt   DateTime  @default(now())

  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockItems  StockItem[]

  @@unique([warehouseId, binCode])
}

model StockItem {
  id               String    @id @default(uuid())
  skuId            String
  warehouseId      String
  binId            String?
  quantityOnHand   Int       @default(0)
  quantityReserved Int       @default(0)
  batchNo          String?
  mfgDate          DateTime?
  expiryDate       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sku              Sku          @relation(fields: [skuId], references: [id])
  warehouse        Warehouse    @relation(fields: [warehouseId], references: [id])
  bin              LocationBin? @relation(fields: [binId], references: [id])
}

model StockMovement {
  id                String    @id @default(uuid())
  skuId             String
  type              String    // inward | outward | transfer | adjustment
  quantity          Int
  supplierId        String?
  sourceWarehouseId String?
  destWarehouseId   String?
  batchNo           String?
  reasonCode        String?
  referenceType     String?   // order | purchase | manual | adjustment
  referenceId       String?
  documentUrl       String?   // URL to GST invoice/purchase document
  performedById     String?
  createdAt         DateTime  @default(now())

  sku               Sku        @relation(fields: [skuId], references: [id])
  supplier          Supplier?  @relation("SupplierMovements", fields: [supplierId], references: [id])
  sourceWarehouse   Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse     Warehouse? @relation("DestWarehouse", fields: [destWarehouseId], references: [id])
  performedBy       User?      @relation("UserStockMovements", fields: [performedById], references: [id])
}

model ProjectStockPosition {
  id                 String    @id @default(uuid())
  project            String    // Project Name (e.g. "Metro PA System Phase 2", "Tech Park CCTV & Access Control")
  reference          String    // Reference / Circuit / BOM Tag (e.g. "BOM-REF-01", "C1-C10", "AMP-RACK-01")
  quantity           Float     @default(1) // Project Base Qty
  itemCode           String    // Item Code / SKU (e.g. "PA-AMP-240W", "TB-MST-10Z")
  partValue          String?   // Part Value / Specs (e.g. "240W 100V RMS", "10-Zone IP")
  package            String?   // Package (e.g. "2U 19-inch Rack", "SMD 0805", "Flush Mount Steel Box")
  unit               String    @default("Nos") // Unit (Nos, Pcs, Sets, Mtrs, Drums)
  bomQtyPerUnit      Float     @default(1) // BOM Qty / Unit
  batchQty           Float     @default(1) // Batch Qty
  plannedRequirement Float     @default(1) // Planned Requirement = bomQtyPerUnit * batchQty
  openingStock       Float     @default(0) // Opening Stock
  inflow             Float     @default(0) // Inflow
  outflow            Float     @default(0) // Outflow
  presentStock       Float     @default(0) // Present Stock = openingStock + inflow - outflow
  shortage           Float     @default(0) // Shortage = max(0, plannedRequirement - presentStock)
  status             String    @default("Sufficient") // Sufficient | Shortage | Critical Shortage | Surplus
  notes              String?   // Notes / Remarks / Procurement Status
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([project])
  @@index([itemCode])
  @@index([status])
}

model Quotation {
  id            String    @id @default(uuid())
  quoteNumber   String    @unique
  leadId        String?
  contactId     String?
  createdById   String?
  status        String    @default("draft") // draft | sent | approved | rejected
  subtotal      Float     @default(0)
  taxRate       Float     @default(18.0) // 18% GST
  taxAmount     Float     @default(0)
  totalAmount   Float     @default(0)
  validUntil    DateTime
  notes         String?
  terms         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  lead          Lead?           @relation(fields: [leadId], references: [id])
  contact       Contact?        @relation(fields: [contactId], references: [id])
  createdBy     User?           @relation("CreatedQuotes", fields: [createdById], references: [id])
  lines         QuotationLine[]
  order         Order?
}

model QuotationLine {
  id          String    @id @default(uuid())
  quotationId String
  skuId       String
  quantity    Int
  unitPrice   Float
  discount    Float     @default(0)
  totalPrice  Float
  notes       String?

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sku         Sku       @relation(fields: [skuId], references: [id])
}

model Order {
  id            String    @id @default(uuid())
  orderNumber   String    @unique
  quotationId   String?   @unique
  contactId     String?
  createdById   String?
  status        String    @default("confirmed") // confirmed | processing | dispatched | delivered | cancelled
  paymentStatus String    @default("pending")   // pending | partial | paid
  advancePercent Float?   @default(50.0)
  advanceAmount  Float?   @default(0)
  paidAmount     Float    @default(0)
  balanceAmount  Float    @default(0)
  paymentRef     String?
  subtotal      Float     @default(0)
  taxAmount     Float     @default(0)
  totalAmount   Float     @default(0)
  customerName  String
  customerPhone String
  customerEmail String?
  shippingAddress String?
  notes         String?
  confirmedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  quotation     Quotation?  @relation(fields: [quotationId], references: [id])
  contact       Contact?    @relation(fields: [contactId], references: [id])
  createdBy     User?       @relation("CreatedOrders", fields: [createdById], references: [id])
  lines         OrderLine[]
  shipments     Shipment[]
  invoices      Invoice[]
  payments      PaymentRecord[]
}

model OrderLine {
  id          String    @id @default(uuid())
  orderId     String
  skuId       String
  quantity    Int
  unitPrice   Float
  taxRate     Float     @default(18.0)
  totalPrice  Float

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         Sku       @relation(fields: [skuId], references: [id])
}

model Shipment {
  id              String    @id @default(uuid())
  shipmentNumber  String    @unique
  orderId         String
  courierName     String
  trackingNumber  String
  trackingUrl     String?
  status          String    @default("dispatched") // dispatched | in_transit | out_for_delivery | delivered
  notes           String?
  dispatchedAt    DateTime  @default(now())
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model StatusHistory {
  id          String    @id @default(uuid())
  entityType  String    // order | shipment | lead | quotation
  entityId    String
  fromStatus  String?
  toStatus    String
  changedById String?
  note        String?
  changedAt   DateTime  @default(now())
}

model AutomationRule {
  id                String           @id @default(uuid())
  name              String
  triggerEvent      String           // lead_created | order_confirmed | order_dispatched | order_delivered | stock_low | followup_overdue
  conditionJson     String           @default("{}")
  actionType        String?          // Legacy single action compatibility (NO whatsapp)
  actionPayloadJson String?          @default("{}")
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  steps             AutomationStep[]
}

model AutomationStep {
  id         String         @id @default(uuid())
  ruleId     String
  stepOrder  Int            @default(1)
  stepType   String         // send_email | send_sms | create_in_app_task | update_lead_field | reassign_record | wait_then_continue
  config     String         // JSON config payload
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model DelayedAutomationJob {
  id           String    @id @default(uuid())
  ruleId       String
  stepIndex    Int       // The step index to resume from
  entityType   String    // e.g. "Lead", "Order"
  entityId     String    // e.g. leadId
  contextJson  String    // serialized context
  executeAt    DateTime  // Scheduled time
  status       String    @default("pending") // pending | completed | cancelled | failed
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([status, executeAt])
}

model MessageLog {
  id                String    @id @default(uuid())
  channel           String    // email | in_app | sms
  recipient         String
  subject           String?
  body              String
  status            String    @default("sent") // sent | failed | queued
  errorMessage      String?
  relatedEntityType String?
  relatedEntityId   String?
  sentAt            DateTime  @default(now())
}

model AuditLog {
  id          String    @id @default(uuid())
  actorId     String?
  actorName   String?
  action      String    // CREATE | UPDATE | DELETE | STATUS_CHANGE | LOGIN
  entityName  String
  entityId    String
  beforeState String?
  afterState  String?
  ipAddress   String?
  timestamp   DateTime  @default(now())

  actor       User?     @relation("UserAuditLogs", fields: [actorId], references: [id])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique // e.g. JNC/26-27/0001, 002/26-27, 013/25-26, 024/26-27
  docType         String        @default("tax_invoice") // tax_invoice | sez_invoice | proforma_invoice | delivery_challan
  orderId         String?
  companyId       String?
  createdById     String?
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerGstin   String?
  customerState   String        @default("Karnataka")
  billingAddress  String?
  deliveryAddress String?
  referenceNo     String?
  buyerOrderNo    String?
  poDate          DateTime?
  lutBondNo       String?       @default("AD290525013648T")
  lutValidity     String?       @default("From : 10/05/2025 To: 09/05/2026")
  isSez           Boolean       @default(false)
  advancePercent  Float?
  advanceAmount   Float?
  advanceAdjusted Float?        @default(0)
  balanceDue      Float?        @default(0)
  paymentMethod   String?       // NEFT | RTGS | IMPS | Cheque | UPI | Cash
  transactionRef  String?       // UTR / Cheque Reference
  subtotal        Float         @default(0)
  cgstAmount      Float         @default(0)
  sgstAmount      Float         @default(0)
  igstAmount      Float         @default(0)
  totalAmount     Float         @default(0)
  paymentTerms    String?       @default("Advance")
  paymentStatus   String        @default("unpaid") // unpaid | partial | paid
  pdfUrl          String?
  isVoided        Boolean       @default(false)
  voidedAt        DateTime?
  voidReason      String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order?        @relation(fields: [orderId], references: [id])
  company         Company?      @relation(fields: [companyId], references: [id])
  createdBy       User?         @relation("CreatedInvoices", fields: [createdById], references: [id])
  lines           InvoiceLine[]
  payments        PaymentRecord[]
}

model InvoiceLine {
  id          String    @id @default(uuid())
  invoiceId   String
  skuId       String?
  hsnCode     String?   // Snapshot at generation time
  description String
  unit        String    @default("No's") // No's, Sets, Mtrs, Pcs, etc.
  quantity    Int
  unitPrice   Float
  taxRate     Float     @default(18.0)
  cgstRate    Float     @default(0)
  cgstAmount  Float     @default(0)
  sgstRate    Float     @default(0)
  sgstAmount  Float     @default(0)
  igstRate    Float     @default(0)
  igstAmount  Float     @default(0)
  lineTotal   Float

  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sku         Sku?      @relation(fields: [skuId], references: [id])
}

model StockTransfer {
  id                     String    @id @default(uuid())
  transferNumber         String    @unique // e.g. JNC-TRF-00001
  skuId                  String
  sourceWarehouseId      String
  destinationWarehouseId String
  quantity               Int
  status                 String    @default("in_transit") // in_transit | completed | cancelled
  notes                  String?
  initiatedById          String?
  initiatedAt            DateTime  @default(now())
  receivedById           String?
  receivedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sku                    Sku       @relation(fields: [skuId], references: [id])
  sourceWarehouse        Warehouse @relation("SourceTransfers", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse   Warehouse @relation("DestTransfers", fields: [destinationWarehouseId], references: [id])
  initiatedBy            User?     @relation("InitiatedTransfers", fields: [initiatedById], references: [id])
  receivedBy             User?     @relation("ReceivedTransfers", fields: [receivedById], references: [id])
}

model CustomObject {
  id          String        @id @default(uuid())
  apiName     String        @unique // e.g. amc_contract, site_visit
  label       String        // e.g. "AMC Contract"
  pluralLabel String        // e.g. "AMC Contracts"
  description String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy   User?         @relation("CreatedCustomObjects", fields: [createdById], references: [id])
  fields      CustomField[]
  records     CustomObjectRecord[]
}

model CustomField {
  id                 String       @id @default(uuid())
  objectId           String
  apiName            String       // e.g. annual_charge, visit_date
  label              String       // e.g. "Annual Service Charge"
  fieldType          String       // text | textarea | number | currency | date | checkbox | picklist | lookup | email | phone | url
  isRequired         Boolean      @default(false)
  isUnique           Boolean      @default(false)
  picklistValues     String?      // JSON array string e.g. ["Active", "Expired", "Pending"]
  lookupTargetObject String?      // e.g. "Lead", "Order", "amc_contract"
  displayOrder       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?    // Soft delete/archive

  object             CustomObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, apiName])
}

model CustomObjectRecord {
  id          String        @id @default(uuid())
  objectId    String
  data        String        // JSON string holding all field values keyed by field api_name
  createdById String?
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?     // Soft-delete

  object      CustomObject  @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("CreatedCustomRecords", fields: [createdById], references: [id])
  updatedBy   User?         @relation("UpdatedCustomRecords", fields: [updatedById], references: [id])

  @@index([objectId])
  @@index([deletedAt])
}

model SystemSetting {
  key       String   @id // e.g. "invoice_signatory_config"
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

model AccountLockout {
  id             String    @id @default(uuid())
  identityKey    String    @unique // normalized email or username
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastAttemptAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PaymentRecord {
  id              String    @id @default(uuid())
  orderId         String?
  invoiceId       String?
  amount          Float
  paymentType     String    @default("advance") // advance | milestone | final_settlement | full_payment
  paymentMethod   String    @default("NEFT")    // NEFT | RTGS | IMPS | Cheque | UPI | Cash
  transactionRef  String?   // UTR / Cheque No / Reference ID
  paymentDate     DateTime  @default(now())
  notes           String?
  recordedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order           Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy      User?     @relation("RecordedPayments", fields: [recordedById], references: [id])

  @@index([orderId])
  @@index([invoiceId])
}

model Team {
  id           String   @id @default(uuid())
  name         String   @unique
  allowedPages String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]   @relation("UserTeam")
}

model Project {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  status      String            @default("active") // active | completed | on_hold
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  createdBy   User?             @relation("CreatedProjects", fields: [createdById], references: [id])
  dailyLogs   ProjectDailyLog[]
  assignments ProjectAssignment[]
}

model ProjectDailyLog {
  id           String   @id @default(uuid())
  projectId    String
  logDate      DateTime @default(now())
  uploadedById String?
  fileName     String?  // Excel/CSV filename
  taskSummary  String?  // Notes/Summary of work done
  recordsJson  String   // JSON stringified array of row items parsed from uploaded Excel sheet
  rawPayload   String?
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation("UploadedProjectLogs", fields: [uploadedById], references: [id])

  @@index([projectId])
}

model ProjectAssignment {
  id           String   @id @default(uuid())
  projectId    String
  userId       String
  roleInProject String? // "lead" | "developer"
  assignedById String?
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation("AssignedProjectUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("AssignedByProjectUser", fields: [assignedById], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}
